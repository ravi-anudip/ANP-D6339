<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
</head>
<body>

  <h1>user</h1>

  <table>
    <thead>
      <th>id</th>
      <th>first name</th>
      <th>last name</th>
      <th>Date of birth</th>
      <th>gender</th>
    </thead>

    <tbody>

        <% if(users.length === 0)  { %>
            <p>no users</p>
          <%}%>

          <% users.forEach((u)=>{%>
            <td><%= u.fname %></td>
          <%})%>


    </tbody>

  </table>
  
</body>
</html>